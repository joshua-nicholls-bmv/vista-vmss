<UserControl x:Class="Vista.Desktop.AirportPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><TextBox x:Name="Input" MaxLength="100" AutomationProperties.Name="Airport ICAO or name" TextChanged="InputChanged" PreviewKeyDown="InputKey" GotKeyboardFocus="InputFocused" LostKeyboardFocus="InputBlurred"/>
<Popup x:Name="Suggestions" PlacementTarget="{Binding ElementName=Input}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="4" MinWidth="280"><ListBox x:Name="Results" DisplayMemberPath="Label" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" MaxHeight="240" PreviewMouseLeftButtonUp="ResultClicked" PreviewKeyDown="ResultKey"/></Border></Popup></Grid></UserControl>
