<Window x:Class="Vista.Desktop.SharedMissionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource WingFont}" FontSize="14" Title="VISTA · Shared missions" Background="{StaticResource Background}" Foreground="{StaticResource Text}" Width="1100" Height="740" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner"><Grid Margin="24" Background="{StaticResource Background}" TextElement.Foreground="{StaticResource Text}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SHARED WITH THE WING" Style="{StaticResource Eyebrow}"/><TextBlock Text="Shared missions" Style="{StaticResource PageTitle}"/><TextBlock Text="Published for active VISTA pilots · import a plan into your own library before flying." Foreground="{StaticResource Muted}"/><WrapPanel Margin="0,12,0,12"><TextBox Text="{Binding SharedSearch,UpdateSourceTrigger=PropertyChanged}" Width="230" AutomationProperties.Name="Search shared missions"/><ComboBox ItemsSource="{Binding SharedSquadrons}" SelectedItem="{Binding SharedSquadron}" Width="260" Margin="12,0"/><Button Content="Refresh" Command="{Binding RefreshSharedMissionsCommand}"/></WrapPanel></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions><DataGrid ItemsSource="{Binding SharedMissionView}" SelectedItem="{Binding SelectedSharedMission}" IsReadOnly="True" Margin="0,0,18,0"><DataGrid.Columns><DataGridTextColumn Header="Mission" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Squadron" Binding="{Binding Squadron}" Width="180"/><DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="120"/></DataGrid.Columns></DataGrid><Border Grid.Column="1" Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="{Binding SharedDetails}" TextWrapping="Wrap" LineHeight="25"/><Button Content="Add to my missions" Command="{Binding ImportSharedMissionCommand}" Style="{StaticResource BlueButton}" Margin="0,18,0,8"/><Button Content="Withdraw sharing" Command="{Binding WithdrawSharedMissionCommand}" Visibility="{Binding CanWithdrawShared,Converter={StaticResource BoolVisibility}}"/></StackPanel></Border></Grid><TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource Accent}" Margin="0,16,0,0" TextWrapping="Wrap"/></Grid></Window>
