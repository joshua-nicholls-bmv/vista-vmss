<UserControl x:Class="Vista.Desktop.MissionPlannerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Vista.Desktop">
<UserControl.Resources><Style x:Key="CorridorChoice" TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="ChoiceFrame" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="TickBox" Width="18" Height="18" CornerRadius="4" BorderBrush="{StaticResource Muted}" BorderThickness="1" VerticalAlignment="Top"><TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" Foreground="#0C1725" FontWeight="Bold" HorizontalAlignment="Center"/></Border><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="TickBox" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFrame" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></UserControl.Resources>

  <Grid Margin="24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel>
      <TextBlock Text="OPERATIONS / PLANNING" Style="{StaticResource Eyebrow}"/><TextBlock Text="Mission planner" FontSize="32" FontWeight="SemiBold"/>
      <TextBlock Text="Build a sortie, choose its load and review the complete route." Foreground="{StaticResource Muted}" Margin="0,8,0,18" TextWrapping="Wrap"/>
<WrapPanel Margin="0,0,0,18"><Button Content="01  Aircraft &amp; airports" Command="{Binding PlannerAircraftCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding PlannerAircraftStage}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#0C1725"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="02  Mission tasks" Command="{Binding PlannerTasksCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding PlannerTaskStage}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#0C1725"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="03  Review &amp; save" Command="{Binding PlannerReviewCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding PlannerReviewStage}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#0C1725"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></WrapPanel></StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,18,0"><StackPanel Visibility="{Binding PlannerAircraftStage,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}" Padding="22"><StackPanel>
        <TextBlock Text="01 / Aircraft and airports" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Text="Aircraft"/><ComboBox ItemsSource="{Binding AvailableAircraft}" SelectedItem="{Binding SelectedAircraft}" DisplayMemberPath="Label" AutomationProperties.Name="Mission aircraft"/>
        <TextBlock Text="Arrival selection"/><ComboBox ItemsSource="{Binding ArrivalSelections}" SelectedItem="{Binding ArrivalSelection}" AutomationProperties.Name="Arrival selection"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,15,0"><TextBlock Text="Departure airport / ICAO"/><local:AirportPicker Text="{Binding DepartureIcao,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Airports="{Binding Bases}"/><TextBlock Text="{Binding DepartureRecognition}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Arrival airport / ICAO"/><local:AirportPicker Visibility="{Binding ChooseArrivalAirport,Converter={StaticResource BoolVisibility}}" Text="{Binding ArrivalIcao,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Airports="{Binding Bases}"/><TextBlock Text="{Binding ArrivalAssignment}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/></StackPanel>
        </Grid>
      </StackPanel></Border><Button Content="Continue to mission tasks →" Style="{StaticResource BlueButton}" Command="{Binding PlannerTasksCommand}"/></StackPanel><StackPanel Visibility="{Binding PlannerTaskStage,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="02 / Add mission tasks and loads" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock Text="Add one or more tasks in the order you want to fly them." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
        <TextBlock Text="Mission type"/><ComboBox ItemsSource="{Binding BuilderFamilies}" SelectedItem="{Binding BuilderFamily}" DisplayMemberPath="Title" AutomationProperties.Name="Mission type"/>
        <TextBlock Text="Location"/><ComboBox ItemsSource="{Binding BuilderOptions}" SelectedItem="{Binding BuilderOption}" DisplayMemberPath="Title" AutomationProperties.Name="Mission option"/>
        <StackPanel Visibility="{Binding TaskNeedsLoad,Converter={StaticResource BoolVisibility}}"><TextBlock Text="Load type" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding PayloadKinds}" SelectedItem="{Binding PayloadKind}" AutomationProperties.Name="Load type" Width="180" HorizontalAlignment="Left"/>
        <TextBlock Text="Load"/><ComboBox ItemsSource="{Binding BuilderPayloads}" SelectedItem="{Binding BuilderPayload}" DisplayMemberPath="Label" AutomationProperties.Name="Load preset"/>
        <TextBlock Text="{Binding PayloadDescription}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        </StackPanel><UniformGrid Columns="3" Margin="0,4,0,12"><Button Content="Randomise location" Command="{Binding RandomOptionCommand}" Padding="10,10"/><Button Content="Randomise load" Command="{Binding RandomPayloadCommand}" Padding="10,10"/><Button Content="Randomise all" Command="{Binding RandomiseAllCommand}" Padding="10,10"/></UniformGrid>
        <Button Style="{StaticResource BlueButton}" Content="Add task" Command="{Binding AddMissionTaskCommand}" HorizontalAlignment="Left"/>
      </StackPanel></Border><Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="{Binding TasksHeading}" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>
        
        <DataGrid ItemsSource="{Binding BuilderTasks}" SelectedItem="{Binding BuilderTask}" IsReadOnly="True" Height="180" AutomationProperties.Name="Sortie tasks"><DataGrid.Columns>
          <DataGridTextColumn Header="Mission" Binding="{Binding Task}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Load" Binding="{Binding Load}" Width="*" MinWidth="140"/>
        </DataGrid.Columns></DataGrid>
        <WrapPanel Margin="0,12,0,0"><Button Content="Move up" Command="{Binding MoveMissionUpCommand}"/><Button Content="Move down" Command="{Binding MoveMissionDownCommand}"/><Button Content="Remove task" Command="{Binding RemoveMissionTaskCommand}"/><Button Content="Randomise task" Command="{Binding RerollMissionTaskCommand}"/></WrapPanel>
      </StackPanel></Border><Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"><StackPanel>
        <Expander Foreground="{StaticResource Text}"><Expander.Header><StackPanel Margin="4,0,0,4"><TextBlock Text="Lichfield corridor" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Optional transit · FL140" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Expander.Header><StackPanel Margin="0,16,0,0">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<CheckBox Style="{StaticResource CorridorChoice}" IsChecked="{Binding CorridorOutbound}" AutomationProperties.Name="Lichfield outbound transit FL140" Margin="0,0,6,0"><StackPanel><TextBlock Text="Outbound" FontWeight="SemiBold"/><TextBlock Text="East → west" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="Before mission tasks · FL140" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></CheckBox>
<CheckBox Grid.Column="1" Style="{StaticResource CorridorChoice}" IsChecked="{Binding CorridorReturn}" AutomationProperties.Name="Lichfield return transit FL140" Margin="6,0,0,0"><StackPanel><TextBlock Text="Return" FontWeight="SemiBold"/><TextBlock Text="West → east" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/><TextBlock Text="After mission tasks · FL140" Foreground="{StaticResource Accent}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></CheckBox>
</Grid><TextBlock Text="Select either or both legs. Return waypoints run in reverse order, offset 1 NM north." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel></Expander></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"><StackPanel><TextBlock Text="Final arrival" Foreground="{StaticResource Accent}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ArrivalAssignment}" Margin="0,8,0,4"/><TextBlock Text="Finish at your departure base, independently of corridor transit." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/><Button Content="Set arrival to departure base" Command="{Binding ReturnToBaseCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
<Button Content="{Binding ReviewTasksLabel}" IsEnabled="{Binding CanReviewTasks}" Style="{StaticResource BlueButton}" Command="{Binding PlannerReviewCommand}"/></StackPanel><StackPanel Visibility="{Binding PlannerReviewStage,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"><StackPanel>
        <Button Content="Regenerate entire mission" Click="RegenerateClicked" HorizontalAlignment="Left"/><TextBlock Text="Mission review" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Text="{Binding BuilderNotice}" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <DataGrid ItemsSource="{Binding BuilderRoute}" IsReadOnly="True" Height="240" AutomationProperties.Name="Composed route preview"><DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="35"/><DataGridTextColumn Header="Segment" Binding="{Binding Segment}" Width="*" MinWidth="80"/><DataGridTextColumn Header="Point" Binding="{Binding Identifier}" Width="115"/><DataGridTextColumn Header="Altitude" Binding="{Binding Altitude}" Width="105"/><DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="90"/>
        </DataGrid.Columns></DataGrid>
        <TextBlock Text="Airports are the route endpoints. Direct destination flights can have no intermediate points. FL values use standard pressure; unspecified levels and speeds remain at pilot discretion." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel></Border><Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16"><StackPanel>
      <TextBlock Text="{Binding PlannerBriefingReminder}" Foreground="{StaticResource StatusWarning}" Margin="0,0,0,12"/><TextBlock Text="{Binding PlannerChecklist}" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/><WrapPanel><Button Content="Aircraft / airports" Command="{Binding FixAircraftCommand}"/><Button Content="Tasks" Command="{Binding FixTasksCommand}"/><Button Content="Name / callsign" Click="FocusDetailsClicked"/></WrapPanel><TextBlock Text="Mission name"/><TextBox x:Name="MissionName" Text="{Binding PlanTitle,UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/><TextBlock Text="Sortie details" Foreground="{StaticResource Accent}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>
      
      <TextBlock Text="Flight callsign"/><TextBox Text="{Binding FlightCallsign, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" AutomationProperties.Name="Mission callsign"/>
      <TextBlock Text="Alternate ICAO (optional)"/><local:AirportPicker Text="{Binding AlternateIcao,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Airports="{Binding Bases}"/>
      <TextBlock Text="{Binding AlternateRecognition}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <TextBlock Text="{Binding BuilderRouteLabel}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,22"/>
      <TextBlock Text="TOTAL PLANNING LOAD" Foreground="{StaticResource Muted}" FontSize="12"/>
      <TextBlock Text="{Binding BuilderTotals}" Foreground="{StaticResource Accent}" FontSize="20" TextWrapping="Wrap" Margin="0,10,0,20"/>
      <Button Style="{StaticResource BlueButton}" Content="Save mission" Command="{Binding SaveMissionPlanCommand}" Margin="0,5,0,10"/>
      <Button Content="Save &amp; open SimBrief" Command="{Binding SaveAndDispatchCommand}"/><Button Content="New plan" Command="{Binding NewPlanCommand}" Margin="0,5,0,10"/>
      <Button Content="Refresh catalogue" Command="{Binding RefreshCommand}" Margin="0,5,0,16"/>
      <TextBlock Text="Saving fixes your task choices, loads and route in a draft. Rerolling changes the selected task only. Generate in SimBrief, then activate the mission on Operations to import and sign its briefing." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="13"/>
    </StackPanel></Border></StackPanel></StackPanel></ScrollViewer><ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,8,10" VerticalAlignment="Top"><StackPanel><TextBlock Text="MISSION SUMMARY" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding PlanTitle}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding AircraftSummary}" Margin="0,14,0,14"/><TextBlock Text="{Binding RouteSummary}" Foreground="{StaticResource Accent}" FontSize="22"/><TextBlock Text="{Binding BuilderRouteLabel}" Foreground="{StaticResource Muted}" Margin="0,16,0,16"/><TextBlock Text="{Binding BuilderTotals}" FontSize="18"/><TextBlock Text="{Binding PlannerDistance}" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/><TextBlock Text="{Binding BuilderNotice}" Foreground="{StaticResource Accent}" Margin="0,18,0,0"/></StackPanel></Border></ScrollViewer></Grid></Grid></UserControl>