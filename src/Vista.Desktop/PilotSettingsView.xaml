<UserControl x:Class="Vista.Desktop.PilotSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,28" MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="PERSONNEL / PROFILE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Pilot settings" FontWeight="SemiBold" FontSize="32" Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding SettingsName}" FontSize="24"/><TextBlock Text="{Binding SettingsIdentifier}" Foreground="{StaticResource Accent}" Margin="0,10,0,8"/><TextBlock Text="{Binding SettingsCallsign}"/><TextBlock Text="{Binding PilotRole}" Margin="0,8,0,8"/><TextBlock Text="{Binding SettingsStatus}" Foreground="{StaticResource Muted}"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="SIMBRIEF" Foreground="{StaticResource Accent}"/><TextBlock Text="Pilot ID from SimBrief Account Settings" Margin="0,12,0,0"/><TextBox Text="{Binding SimBriefPilotId,UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.Name="Saved SimBrief Pilot ID"/><Button Style="{StaticResource BlueButton}" Content="Save pilot settings" Command="{Binding SavePilotSettingsCommand}" HorizontalAlignment="Left"/><TextBlock Text="Remembered for this pilot on this computer. Profile name and callsign are managed by the wing." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="PILOT STATISTICS" Foreground="{StaticResource Accent}"/><TextBlock Text="Completed sorties" Margin="0,12,0,0"/><TextBlock Text="{Binding CompletedSorties}" FontSize="24"/><TextBlock Text="Flight hours" Margin="0,12,0,0"/><TextBlock Text="{Binding FlightHours}" FontSize="24"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>