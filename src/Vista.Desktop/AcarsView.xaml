<UserControl x:Class="Vista.Desktop.AcarsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Vista.Desktop">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="24,22" Height="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid.Style><Style TargetType="Grid"><Setter Property="MinHeight" Value="680"/><Style.Triggers><DataTrigger Binding="{Binding ShowMissionSelection}" Value="True"><Setter Property="MinHeight" Value="800"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,14"><Border DockPanel.Dock="Right" Background="{StaticResource Surface}" CornerRadius="16" Padding="14,8" VerticalAlignment="Center"><TextBlock Text="{Binding FlightPhase}" Foreground="{Binding FlightStatusTone,Converter={StaticResource StatusBrush}}" FontWeight="Bold" FontSize="12"/></Border><StackPanel><TextBlock Text="WING OPERATIONS" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ActiveMissionLabel}" FontSize="26" FontWeight="SemiBold"/><Button Content="{Binding DeactivateLabel}" Click="CancelActiveClicked" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasActiveSortie,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding ActiveMissionRoute}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></DockPanel>
<Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14" Visibility="{Binding ShowMissionSelection,Converter={StaticResource BoolVisibility}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="01 / SELECT SAVED MISSION" Style="{StaticResource Eyebrow}"/><TextBlock Text="Search name or callsign / choose mission" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox Text="{Binding MissionSearch,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find saved mission" ToolTip="Filter by mission name or callsign" Margin="0,0,10,8"/><ComboBox Grid.Column="1" ItemsSource="{Binding OperationMissions}" SelectedItem="{Binding OperationMission}" DisplayMemberPath="Title" IsTextSearchEnabled="True" TextSearch.TextPath="Title" AutomationProperties.Name="Saved mission selection" Margin="0,0,0,8"/></Grid><TextBlock Text="{Binding OperationPreview}" Foreground="{StaticResource Muted}" FontSize="12" MaxHeight="58" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding OperationTasks}" Foreground="{StaticResource Muted}" FontSize="12" MaxHeight="55" TextTrimming="CharacterEllipsis"/><WrapPanel Margin="0,8,0,0"><Button Content="Activate &amp; brief" Style="{StaticResource BlueButton}" Command="{Binding ActivateAndBriefCommand}"/><Button Content="View briefing" Command="{Binding ViewBriefingCommand}"/></WrapPanel></StackPanel></Grid></Border>
<StackPanel Grid.Row="2" Margin="0,0,0,12">
<WrapPanel Margin="0,0,0,8"><TextBlock Text="{Binding SimulatorReadyLabel}" Margin="0,0,22,0" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding BriefingReadyLabel}" Margin="0,0,22,0"/><TextBlock Text="{Binding AircraftReadyLabel}"/></WrapPanel>
<TextBlock Text="{Binding PreparationSummary}" Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock Text="{Binding PreparationError}" Foreground="{StaticResource StatusWarning}" FontSize="12"/>
<WrapPanel Margin="0,8,0,0"><Button Content="{Binding SimulatorActionLabel}" Command="{Binding SimulatorToggleCommand}"/><Button Content="{Binding NextFlightActionLabel}" Style="{StaticResource BlueButton}" Command="{Binding NextFlightActionCommand}" Visibility="{Binding ShowNextFlightAction,Converter={StaticResource BoolVisibility}}"/><Button Content="Retry sync" Command="{Binding RetryTrackUploadCommand}" Visibility="{Binding ShowRetrySync,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
<CheckBox Content="Aircraft and mission checked" IsChecked="{Binding AircraftChecked}" Margin="0,6,0,0" Visibility="{Binding ShowAircraftCheck,Converter={StaticResource BoolVisibility}}"/>
</StackPanel>
<Grid Grid.Row="3" MinHeight="180"><Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="14" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="MISSION MAP" Style="{StaticResource Eyebrow}"/><TextBlock DockPanel.Dock="Right" Text="Route / blue   Track / red   Next / gold" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><local:TrackMap x:Name="FlightMap" Grid.Row="1" Route="{Binding ActiveRoute}" Track="{Binding LocalTrackPoints}" Departure="{Binding ActiveDeparture}" Arrival="{Binding ActiveArrival}" NextPointIndex="{Binding CurrentMissionPointIndex}"/><WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Fit mission" Click="FitRouteClicked" Padding="12,7" MinHeight="34"/><Button Content="Enlarge" Click="EnlargeMapClicked" Padding="12,7" MinHeight="34"/><CheckBox Content="Follow aircraft" IsChecked="{Binding FollowAircraft,ElementName=FlightMap,Mode=TwoWay}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12"/></WrapPanel></Grid></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="NEXT MISSION POINT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ProgressTitle}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding ProgressCount}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="{Binding ProgressNavigation}" Foreground="{StaticResource Accent}" Margin="0,10,0,10"/><TextBlock Text="{Binding ProgressInstructions}" FontSize="13"/><TextBlock Text="{Binding WaypointCallout}" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,10,0,0"/><WrapPanel><Button Content="Previous" Command="{Binding PreviousMissionPointCommand}" Padding="10,7" MinHeight="34"/><Button Content="Pass / skip" Command="{Binding NextMissionPointCommand}" Padding="10,7" MinHeight="34"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0"><StackPanel><DockPanel><Ellipse Width="8" Height="8" Fill="{Binding ConnectionStatusTone,Converter={StaticResource StatusBrush}}" Margin="0,0,8,0"/><TextBlock Text="AIRCRAFT TELEMETRY" Style="{StaticResource Eyebrow}" Margin="0"/></DockPanel><TextBlock Text="{Binding SimulatorAircraft}" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="{Binding SimulatorGround}" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding SimulatorMetrics}" Margin="0,10,0,6"/><TextBlock Text="{Binding FuelRemaining}"/><TextBlock Text="{Binding EngineStatusLabel}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock Text="{Binding SimulatorPosition}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="{Binding FlightCounters}" FontSize="12" Margin="0,10,0,0"/><TextBlock Text="{Binding LandingRate}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Grid>
<StackPanel Grid.Row="4" Margin="0,12,0,0"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14,9"><UniformGrid Columns="5"><StackPanel><TextBlock Text="OUT / STAND" Style="{StaticResource Eyebrow}" Margin="0"/><TextBlock Text="{Binding OutClock}"/></StackPanel><StackPanel><TextBlock Text="OFF / TAKEOFF" Style="{StaticResource Eyebrow}" Margin="0"/><TextBlock Text="{Binding OffClock}"/></StackPanel><StackPanel><TextBlock Text="ON / LANDING" Style="{StaticResource Eyebrow}" Margin="0"/><TextBlock Text="{Binding OnClock}"/></StackPanel><StackPanel><TextBlock Text="IN / PARKED" Style="{StaticResource Eyebrow}" Margin="0"/><TextBlock Text="{Binding InClock}"/></StackPanel><StackPanel><TextBlock Text="BLOCK TIME" Style="{StaticResource Eyebrow}" Margin="0"/><TextBlock Text="{Binding BlockTime}"/></StackPanel></UniformGrid></Border><TextBlock Text="{Binding UploadStatus}" Foreground="{Binding UploadStatusTone,Converter={StaticResource StatusBrush}}" FontSize="11" Margin="0,5,0,4"/>
<Expander Header="Flight events" Foreground="{StaticResource Muted}"><ListBox ItemsSource="{Binding TrackingEvents}" Height="110" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0"/></Expander>
<Expander Header="Post-flight debrief" Foreground="{StaticResource Muted}"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBox Text="{Binding DebriefNotes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" MaxLength="10000" Margin="0,0,16,0"/><StackPanel Grid.Column="1"><Button Content="Submit completed sortie" Style="{StaticResource BlueButton}" Command="{Binding SubmitDebriefCommand}"/><TextBlock Text="Available after landing, taxi-in and parking brake confirmation." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Grid></Expander></StackPanel>
</Grid></ScrollViewer></UserControl>