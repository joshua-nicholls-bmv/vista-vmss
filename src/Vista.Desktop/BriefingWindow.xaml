<Window x:Class="Vista.Desktop.BriefingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Vista.Desktop" Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="{StaticResource WingFont}" FontSize="14" Title="VISTA · Sortie briefing" Width="1120" Height="830" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterOwner">
 <Grid Margin="24" Background="{StaticResource Background}" TextElement.Foreground="{StaticResource Text}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><Border DockPanel.Dock="Right" Background="{StaticResource Surface}" CornerRadius="16" Padding="14,9" VerticalAlignment="Top"><TextBlock Text="{Binding BriefingState}" Foreground="{StaticResource Accent}" FontWeight="Bold"/></Border><StackPanel><TextBlock Text="SORTIE PREPARATION / BRIEFING DOCUMENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BriefingTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding BriefingOverview}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></DockPanel>
  <TabControl Grid.Row="1" Style="{StaticResource BriefingTabs}" Background="{StaticResource Background}" BorderThickness="0">
   <TabItem Header="Overview" Style="{StaticResource BriefingTab}"><ScrollViewer Foreground="{StaticResource Text}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,12,8">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SIMBRIEF FLIGHT PLAN" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BriefingStatus}" Foreground="{StaticResource Accent}"/><WrapPanel Margin="0,12,0,0"><TextBox Width="140" Text="{Binding SimBriefPilotId,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SimBrief Pilot ID" Margin="0,5,12,5"/><Button Content="Generate SimBrief flight plan" Command="{Binding OpenActiveBriefingCommand}"/><Button Content="Import briefing" Style="{StaticResource BlueButton}" Command="{Binding ImportBriefingCommand}"/><Button Content="Export briefing PDF" Click="ExportPdfClicked"/><Button Content="Full flight plan" Command="{Binding OpenOfpCommand}"/></WrapPanel><TextBlock Text="{Binding BriefingFlight}" FontSize="18" Margin="0,14,0,8"/><TextBlock Text="{Binding BriefingDetails}" Foreground="{StaticResource Muted}"/></StackPanel></Border>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="FUEL PLAN · KG" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BriefingFuelBreakdown}" LineHeight="28"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><StackPanel><TextBlock Text="LOADING &amp; TIMING" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BriefingWeights}" LineHeight="28"/><TextBlock Text="{Binding BriefingOperational}" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/></StackPanel></Border></Grid>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Route" Style="{StaticResource BriefingTab}"><ScrollViewer Foreground="{StaticResource Text}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,12,8"><local:TrackMap Height="300" Route="{Binding BriefingPoints}" Departure="{Binding BriefingDeparture}" Arrival="{Binding BriefingArrival}"/><TextBlock Text="VISTA mission route" Style="{StaticResource Eyebrow}" Margin="0,18,0,10"/><DataGrid ItemsSource="{Binding BriefingPoints}" IsReadOnly="True" Height="220"><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40"/><DataGridTextColumn Header="Waypoint" Binding="{Binding Identifier}" Width="140"/><DataGridTextColumn Header="Altitude · ft" Binding="{Binding AltitudeFt}" Width="110"/><DataGridTextColumn Header="Speed · kt" Binding="{Binding SpeedKts}" Width="110"/><DataGridTextColumn Header="Instruction" Binding="{Binding Instructions}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="SimBrief generated route" Style="{StaticResource Eyebrow}" Margin="0,18,0,10"/><TextBox Text="{Binding BriefingRoute,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Mission tasks" Style="{StaticResource BriefingTab}"><ScrollViewer Foreground="{StaticResource Text}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,12,8"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TASK SEQUENCE" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BriefingTasks}" LineHeight="27"/><TextBlock Text="{Binding BriefingInstructions}" LineHeight="24" Margin="0,20,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="ADDITIONAL EXERCISE BRIEF / NINE-LINE" Style="{StaticResource Eyebrow}"/><TextBlock Text="Add mission-specific briefing information here. Save notes before importing or signing. Saving changes requires a fresh acknowledgement." Foreground="{StaticResource Muted}"/><TextBox Text="{Binding MissionNotes,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBriefingReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxLength="20000" VerticalScrollBarVisibility="Auto"/><Button Content="Save briefing notes" Command="{Binding SaveBriefingNotesCommand}" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Weather" Style="{StaticResource BriefingTab}"><ScrollViewer Foreground="{StaticResource Text}" VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,18,12,8"><StackPanel><TextBlock Text="IMPORTED WEATHER SNAPSHOT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding BriefingWeather}" LineHeight="26"/><TextBlock Text="Weather is saved with this import. Regenerate and reimport SimBrief for an updated briefing. Full operational information is available in the original flight plan." Foreground="{StaticResource Muted}" Margin="0,22,0,0"/></StackPanel></Border></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0"><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="Close" Click="CloseClicked"/><Button Content="Sign briefing paperwork" Style="{StaticResource BlueButton}" Command="{Binding BeginAcknowledgementCommand}"/></WrapPanel><StackPanel><TextBlock Text="{Binding BriefingSignature}" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,12,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.RowSpan="3" Background="#D90C1725" Visibility="{Binding AcknowledgementOpen,Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}" Width="490" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="BRIEFING ACKNOWLEDGEMENT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Sign the sortie paperwork" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding PilotLabel}" Foreground="{StaticResource Accent}" Margin="0,14,0,14"/><CheckBox IsChecked="{Binding AcknowledgementChecked}"><TextBlock Text="I have reviewed the aircraft, route, fuel plan and mission instructions." Width="400"/></CheckBox><TextBlock Text="This is a simulated acknowledgement for VISTA. Your pilot identity and the time will be saved against this briefing version." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,18"/><WrapPanel><Button Content="Back to briefing" Command="{Binding CancelAcknowledgementCommand}"/><Button Content="Sign &amp; close briefing" Style="{StaticResource BlueButton}" Command="{Binding SignAndCloseBriefingCommand}"/></WrapPanel><TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border></Grid>
 </Grid>
</Window>


